__pycache__/
*.pyc
.venv/

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/

# Harness API keys: copy apiConfig.example.json to apiConfig.json (or use the Setup page).
apiConfig.json
config.yaml
