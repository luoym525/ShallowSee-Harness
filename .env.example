# Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git. Never commit real keys and never post them in the team room.

# Model API used by the Researcher and Reviewer roles
ANTHROPIC_API_KEY=

# Harness test runtime: explicitly select a structured-output-capable Claude model.
# Per-role selections override the shared test default; no model ID is assumed.
HARNESS_MODEL=
HARNESS_MODEL_PRESALES=
HARNESS_MODEL_PLANNER=
HARNESS_MODEL_PROJECT_MANAGER=
HARNESS_MODEL_DEVELOPER=
HARNESS_MODEL_TESTER=
HARNESS_MODEL_SUPPORT=

# Linkup live web search: the Researcher's only search tool
LINKUP_API_KEY=

# GitHub token that can push a branch and open a pull request on the handbook repository
GITHUB_TOKEN=
# The handbook repository the agent audits, as owner/name
SHELFLIFE_HANDBOOK_REPO=

# Databricks (only the loader in databricks/ needs these; the core service runs without them)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
