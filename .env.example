# Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git. Never commit real keys and never post them in the team room.

# Model API used to extract claims and judge them
ANTHROPIC_API_KEY=
# A model your account can use that supports structured outputs, for example claude-opus-5-5
SHELFLIFE_ANTHROPIC_MODEL=

# Linkup live web search: the Researcher's only search tool
LINKUP_API_KEY=

# GitHub API token with permission to open a pull request. Git uses its own credentials for the push.
GITHUB_TOKEN=
# Required with --open-pr. The GitHub repository must match both effective origin URLs.
SHELFLIFE_HANDBOOK_REPO=

# Databricks (only the loader in databricks/ needs these; the core service runs without them)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
